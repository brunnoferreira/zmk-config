#include "includes/cornix54.h"
#include "includes/common.dtsi"

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // ----------------------------------------------------------------------------------------------------------------------
            // |   `   |   Q   |   W   |   E   |   R   |   T   |                   |   Y   |   U   |   I   |   O   |   P   |   \   |
            // |   _   | A/CTL | S/ALT | D/CMD | F/SFT |   G   |                   |   H   | J/SFT | K/CMD | L/ALT | ;/CTL |   '   |
            // | -/VMdD|   Z   |   X   |   C   |   V   |   B   |       |       |   |   N   |   M   |   ,   |   .   |  / ?: | EMOJI |
            // |       |       |       | MOUSE |  BSPC |TAB/NUM|                   |ENT/NAV|SPC/MED| MOUSE |       |       |       |
            //
            // Cornix only: the blank keys are unused. Encoders: volume and page up/down.
            // x/Y = tap x, hold Y.  Home-row mods: CTL ALT CMD SFT (mirrored on the right).
            // -/VMdD: tap -, double-tap toggles VMdD.  EMOJI: double-tap for the emoji picker.
            // / ?:  : tap /, hold types "?:".

            bindings = <
&kp GRAVE              &kp Q          &kp W         &kp E         &kp R                &kp T                             &kp Y                 &kp U                &kp I         &kp O         &kp P                                &kp BSLH
&kp UNDERSCORE         &hm_l LCTRL A  &hm_l LALT S  &hm_l LGUI D  &hm_shift_l LSHFT F  &kp G                             &kp H                 &hm_shift_r RSHFT J  &hm_r RGUI K  &hm_r RALT L  &hm_r RCTRL SEMI                     &kp SQT
&td_vmdd_toggle_layer  &kp Z          &kp X         &kp C         &kp V                &kp B               &none  &none  &kp N                 &kp M                &kp COMMA     &kp DOT       &td_kotlin_ternary_operator 0 SLASH  &td_emoji
&none                  &none          &none         &mo L_MOUSE   &kp BACKSPACE        &lt_hold L_NUM TAB                &lt_hold L_NAV ENTER  &lt L_MEDIA SPACE    &mo L_MOUSE   &none         &none                                &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        navigation {
            // Navigation (hold Enter). Left home row is plain CTL ALT CMD SFT (no
            // hold-tap), so holding F (Shift) reliably turns any of these into a selection.
            //
            //   line start | word <- |  up  | word -> | line end
            //   page up    |  left   | down |  right  | page down

            bindings = <
&trans         &trans     &trans    &trans    &trans     &trans                             &kp LG(LEFT)  &kp LA(LEFT)  &kp UP    &kp LA(RIGHT)  &kp LG(RIGHT)  &trans
&trans         &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &trans                             &kp PG_UP     &kp LEFT      &kp DOWN  &kp RIGHT      &kp PG_DN      &trans
&kp RC(RG(Q))  &trans     &trans    &trans    &trans     &trans             &trans  &trans  &trans        &trans        &trans    &trans         &trans         &kp LS(LC(SPACE))
&trans         &trans     &trans    &trans    &trans     &lt_hold L_BT ESC                  &kp RET       &trans        &trans    &trans         &trans         &trans
            >;
        };

        numbers {
            bindings = <
&trans  &trans                                         &trans     &kp AMPS   &kp LBRC              &kp RBRC                               &kp N7   &mt LC(LG(U)) N8  &mt LC(LA(I)) N9  &mt LC(LA(O)) PLUS    &kp ASTERISK  &trans
&trans  &td_kotlin_not_equal_comparison 0 EXCLAMATION  &kp AT     &kp HASH   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                  &kp N4   &kp N5            &kp N6            &td_dash_arrow_right  &kp FSLH      &trans
&trans  &kp DLLR                                       &kp PRCNT  &kp CARET  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans  &trans  &kp N1   &kp N2            &kp N3            &kp DOT               &kp EQUAL     &trans
&trans  &trans                                         &trans     &trans     &trans                &kp SPACE                              &kp RET  &kp N0            &trans            &trans                &trans        &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans        &trans        &trans        &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans  &trans  &trans  &bt BT_CLR  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans      &kp K_VOL_UP         &trans      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &kp C_PREV  &kp C_PP             &kp C_NEXT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &mt K_MUTE K_VOL_DN  &trans      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans      &trans               &trans      &trans  &trans
            >;
        };

        Adjust_layer {
            display-name = "Adjust";

            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | moDEBUG| RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&bt BT_CLR      &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4                   &none        &none       &none   &none  &none             &none
&none           &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4                  &tog L_BASE  &to L_BASE  &none   &none  &none             &tog L_BASE
&bt BT_CLR_ALL  &none          &none          &none          &none          &none          &trans  &trans  &none        &none       &none   &none  &ext_power EP_ON  &kp CAPSLOCK
&none           &none          &none          &none          &none          &none                          &none        &none       &kp N4  &none  &none             &none
            >;
        };

        Navi_layer {
            display-name = "Navi";
            bindings = <
&none  &none  &none           &mmv MOVE_UP    &kp PAGE_UP      &kp PAGE_DOWN                   &mkp MB1  &mkp MB3  &mkp MB2  &msc SCRL_UP  &msc SCRL_DOWN  &none
&none  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_UP                    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT     &none           &none
&none  &none  &none           &none           &none            &msc SCRL_DOWN  &trans  &trans  &trans    &trans    &none     &none         &none           &none
&none  &none  &none           &mo L_DEBUG     &trans           &trans                          &none     &none     &kp N5    &none         &none           &none
            >;
        };

        KeyPad_layer {
            display-name = "NumPad";
            bindings = <
&mo L_DEBUG  &none  &none  &none  &none  &none                        &kp KP_N7        &kp KP_N8        &kp KP_N9        &kp KP_MINUS  &kp KP_MULTIPLY  &none
&none        &none  &none  &none  &none  &none                        &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_N6        &kp KP_PLUS   &kp KP_DIVIDE    &none
&none        &none  &none  &none  &none  &none        &trans  &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_N3        &none         &none            &none
&none        &none  &none  &none  &none  &mo L_DEBUG                  &kp KP_N0        &kp KP_DOT       &kp KP_NUMBER_0  &none         &none            &none
            >;
        };

        NumSym {
            display-name = "Debug";

            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | BTCLR | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &none        &none  &none   &none  &none  &none
&none       &none         &none         &none         &none         &none                         &none        &none  &none   &none  &none  &none
&none       &none         &none         &none         &none         &bootloader   &trans  &trans  &bootloader  &none  &none   &none  &none  &none
&none       &none         &none         &none         &none         &none                         &none        &none  &kp N7  &none  &none  &none
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                            &trans  &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                            &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &bootloader  &bootloader  &trans  &trans          &trans          &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                            &trans  &trans          &trans          &trans           &trans  &trans
            >;
        };

        VMdD {
            display-name = "VMdD";
            bindings = <
&trans                 &trans  &trans  &trans                     &trans  &trans                  &trans  &trans  &trans                     &trans  &trans  &trans
&trans                 &trans  &trans  &trans                     &trans  &trans                  &trans  &trans  &trans                     &trans  &trans  &trans
&td_vmdd_toggle_layer  &trans  &trans  &trans                     &trans  &trans  &trans  &trans  &trans  &trans  &trans                     &trans  &trans  &td_vmdd_search_content
&trans                 &trans  &trans  &td_vmdd_prepare_contents  &trans  &trans                  &trans  &trans  &td_vmdd_prepare_modifier  &trans  &trans  &trans
            >;
        };
    };
};
